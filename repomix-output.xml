const navItems: NavItem[] = [
  {
    href: "/super-admin",
    label: "Super Admin",
    roles: ["super_admin"],
  },
  {
    href: "/admin",
    label: "Admin",
    roles: ["super_admin", "admin"],
  },
  {
    href: "/manager",
    label: "Manager",
    roles: ["super_admin", "admin", "manager"],
  },
  {
    href: "/staff",
    label: "Staff",
    roles: ["super_admin", "admin", "manager", "staff"],
  },
